# ==============================================================================
# MIC SMART CAMPUS — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Supabase Public Configuration (Safe for Next.js Web and Flutter Mobile)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
NEXT_PUBLIC_APP_NAME="MIC Smart Campus"
NEXT_PUBLIC_APP_TAGLINE="Learn • Connect • Grow"
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-Side Privileged Secrets (NEVER expose to Client/Mobile/Public Web)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_DB_PASSWORD=your_secure_db_password_here

# Flutter Mobile Configuration (Used during dart-define or build)
# flutter run --dart-define=SUPABASE_URL=https://your-project.supabase.co --dart-define=SUPABASE_ANON_KEY=...
FLUTTER_SUPABASE_URL=https://your-project-id.supabase.co
FLUTTER_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Firebase Cloud Messaging (Optional Push Notifications)
FCM_SERVER_KEY=
FIREBASE_PROJECT_ID=

# Timezone and Localization
DEFAULT_TIMEZONE=Asia/Dhaka
DEFAULT_CURRENCY=BDT
DEFAULT_LOCALE=en-BD
