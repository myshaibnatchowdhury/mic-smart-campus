{
  "name": "mic-smart-campus-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build:packages": "npm run build --workspaces --if-present",
    "build:web": "npm run build --workspace=apps/web",
    "lint": "npm run lint --workspaces --if-present"
  }
}
